        "options": {
          "queryParams": "={{ $json.dunning_case_id }},={{ $json.invoice_id }},={{ $json.stripe_customer_id }},={{ $json.account_id }},={{ $json.plan_tier }},={{ $json.decline_reason }},={{ $json.amount_due_cents }},={{ $json.currency }},={{ $json.mrr_cents }},={{ $json.high_value }},={{ $json.card_last4 }},={{ $json.card_brand }},={{ $json.failed_at }}"
        }

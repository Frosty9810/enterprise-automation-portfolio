      "id": "a1b2c3d4-0023-4a1a-9c1a-000000000023",
      "name": "Webhook - Stripe Trial End Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1600, 980],
      "webhookId": "stripe-trial-end"
    },
    {
      "parameters": {
        "jsCode": "// Normalize the Stripe trial_will_end / subscription webhook event.\nconst body = $input.first().json.body || $input.first().json;\nconst obj = (body.data && body.data.object) || {};\n\nreturn [{\n  json: {\n    stripe_event_type: body.type,\n    stripe_customer_id: obj.customer,\n    stripe_subscription_id: obj.id,\n    trial_end: obj.trial_end,\n    default_payment_method: obj.default_payment_method || null,\n    account_id: (obj.metadata && obj.metadata.account_id) || null\n  }\n}];"
      },
      "id": "a1b2c3d4-0024-4a1a-9c1a-000000000024",
      "name": "Code - Normalize Stripe Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1380, 980]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.stripe.com/v1/customers/' + $json.stripe_customer_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }

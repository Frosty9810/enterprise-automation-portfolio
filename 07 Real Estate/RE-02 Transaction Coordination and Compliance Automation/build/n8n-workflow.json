    {
      "parameters": {
        "jsCode": "// TC exception queue entry — no Dotloop loop is created (SOP Section 16/21).\nconst item = $input.first().json;\nreturn [{\n  json: {\n    exception_type: 'transaction_type_invalid',\n    opportunity_id: item.opportunity_id,\n    reason: item.reason,\n    created_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "a1b2c3d4-0009-4a11-8f01-000000000009",
      "name": "Code: Build Exception Record",

    {
      "parameters": {
        "jsCode": "// Validate transaction_type against the enumerated set and map to a Dotloop template.\n// Mirrors SOP Section 14 select_template_id() / Section 16 data validation table.\nconst allowed = ['financed', 'cash', 'short_sale'];\nconst templateMap = {\n  financed: 'tmpl_financed_purchase_v3',\n  cash: 'tmpl_cash_purchase_v2',\n  short_sale: 'tmpl_short_sale_purchase_v4'\n};\n\nconst data = $input.first().json.body.data;\nconst custom = data.custom || {};\nconst txnType = custom.transaction_type;\n\nif (!allowed.includes(txnType)) {\n  return [{\n    json: {\n      routeToException: true,\n      reason: `Unrecognized or missing transaction_type: '${txnType}'`,\n      opportunity_id: data.id\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    routeToException: false,\n    opportunity_id: data.id,\n    template_id: templateMap[txnType],\n    transaction_type: txnType,\n    office_code: custom.office_code,\n    property_address: custom.property_address,\n    buyer_name: custom.buyer_name,\n    buyer_email: custom.buyer_email,\n    buyer_phone: custom.buyer_phone,\n    seller_name: custom.seller_name,\n    seller_email: custom.seller_email,\n    seller_phone: custom.seller_phone,\n    listing_agent_email: custom.listing_agent_email,\n    buyer_agent_email: custom.buyer_agent_email,\n    escrow_officer_name: custom.escrow_officer_name,\n    escrow_officer_email: custom.escrow_officer_email,\n    escrow_officer_phone: custom.escrow_officer_phone,\n    date_updated: data.date_updated\n  }\n}];"
      },
      "id": "a1b2c3d4-0003-4a11-8f01-000000000003",
      "name": "Code: Validate Type & Select Template",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1160,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-exception-route",
              "leftValue": "={{ $json.routeToException }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4a11-8f01-000000000004",
      "name": "If: Route To TC Exception Queue",
      "type": "n8n-nodes-base.if",

    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id AS transaction_id, dotloop_loop_id, office_code, office_timezone\nFROM transactions\nWHERE status = 'active'\n  AND lifecycle_state NOT IN ('closed', 'fell_through');",
        "options": {}

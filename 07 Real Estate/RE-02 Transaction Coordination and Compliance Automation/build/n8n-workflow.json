        "subject": "=Deadline due today: {{ $json.milestone }} — {{ $json.property_address }}",
        "message": "=This is a reminder that the {{ $json.milestone }} deadline for {{ $json.property_address }} is due today ({{ $json.due_date }}). Please complete the required step in Dotloop or contact your transaction coordinator.",
        "options": {}
      },
      "id": "a1b2c3d4-0021-4a11-8f01-000000000015",

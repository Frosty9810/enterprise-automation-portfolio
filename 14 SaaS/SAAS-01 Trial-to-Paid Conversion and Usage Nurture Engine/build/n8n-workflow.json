      "id": "a1b2c3d4-0012-4a1a-9c1a-000000000012",
      "name": "Schedule - Hourly Checkpoint Sweep",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1600, 660]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.account_id, a.hubspot_contact_id, a.trial_end_date,\n       u.trial_day, u.integrations_connected, u.seats_invited,\n       u.workflows_created, u.features_activated, u.intent_score,\n       u.intent_tier, u.checkpoint_stage_sent\nFROM trial_accounts a\nJOIN account_usage_daily u ON u.account_id = a.account_id\nWHERE a.is_active_trial = true\n  AND u.score_date = (SELECT MAX(score_date) FROM account_usage_daily WHERE account_id = a.account_id)\n  AND (a.trial_end_date - CURRENT_DATE) IN (7, 3, 1);",
        "options": {}
      },
      "id": "a1b2c3d4-0013-4a1a-9c1a-000000000013",
      "name": "Postgres - Read Checkpoint Candidates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-1380, 660],
      "credentials": {
        "postgres": {
          "id": "atlas-postgres-usage-db",
          "name": "Atlas Metrics Usage Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Determine which checkpoint (day_7 / day_3 / day_1) applies and build\n// the milestone personalization payload (SOP Section 12 Step 3).\nreturn $input.all().map(item => {\n  const row = item.json;\n  const daysRemaining = row.trial_day !== undefined\n    ? null\n    : null;\n\n  const trialEnd = new Date(row.trial_end_date);\n  const today = new Date();\n  const remaining = Math.round((trialEnd.getTime() - today.getTime()) / (24 * 60 * 60 * 1000));\n\n  let checkpoint = null;\n  if (remaining === 7) checkpoint = 'day_7';\n  else if (remaining === 3) checkpoint = 'day_3';\n  else if (remaining === 1) checkpoint = 'day_1';\n\n  const alreadySent = (row.checkpoint_stage_sent || []).includes(checkpoint);\n\n  const milestonesHit = [];\n  const milestonesMissed = [];\n  if (row.integrations_connected > 0) milestonesHit.push(`integrations_connected:${row.integrations_connected}`);\n  else milestonesMissed.push('integrations_connected:0');\n  if (row.seats_invited > 0) milestonesHit.push(`seats_invited:${row.seats_invited}`);\n  else milestonesMissed.push('seats_invited:0');\n\n  return {\n    json: {\n      ...row,\n      checkpoint,\n      should_send: checkpoint !== null && !alreadySent,\n      milestones_hit: milestonesHit,\n      milestones_missed: milestonesMissed\n    }\n  };\n});"
      },
      "id": "a1b2c3d4-0014-4a1a-9c1a-000000000014",
      "name": "Code - Determine Checkpoint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1160, 660]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1d2e3f4-0001",
              "leftValue": "={{ $json.should_send }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0015-4a1a-9c1a-000000000015",
      "name": "If - Checkpoint Due",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-940, 660]

        "profile": "echo",
        "entities": [
          {
            "id": "person",
            "value": "Ada Example"
          }
        ],
        "frames": {
          "query": "Ada Example and ada example are supplied spellings.",
          "context": [
            "Public synthetic context."
          ],
          "history": [
            {
              "role": "user",
              "text": "Use only the supplied fixture."
            }
          ],
          "tools": [
            {
              "name": "lookup_delivery",
              "args": {
                "contact": "Ada Example",
                "items": [
                  {
                    "note": "Public synthetic fixture."
                  }
                ]
              }
            }
          ]
        }
      },
      "expected": {
        "status": "rejected",
        "errorCode": "declared_literal_variant_leak",
        "exposedVariants": []
      },
      "rationale": "After the exact spelling is aliased, the lowercase spelling is NFKC-lowercase equivalent to the declared literal and must reject the entire proposal before persistence."
    },

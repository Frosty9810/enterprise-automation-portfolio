      "id": "a1b2c3d4-0016-4a11-8f01-000000000010",
      "name": "Schedule: Nightly Deadline Evaluator (06:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        -1600,
        820
      ]

    {
      "parameters": {
        "url": "https://api.dotloop.com/v2/loops",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "dotloopOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Request-Id",
              "value": "={{ $json.opportunity_id }}-under-contract"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  template_id: $json.template_id,\n  loop_name: $json.property_address,\n  property: {\n    street_address: $json.property_address\n  },\n  participants: [\n    { role: \"buyer\", name: $json.buyer_name, email: $json.buyer_email, phone: $json.buyer_phone },\n    { role: \"seller\", name: $json.seller_name, email: $json.seller_email, phone: $json.seller_phone },\n    { role: \"listing_agent\", email: $json.listing_agent_email },\n    { role: \"buyer_agent\", email: $json.buyer_agent_email },\n    { role: \"escrow_officer\", name: $json.escrow_officer_name, email: $json.escrow_officer_email, phone: $json.escrow_officer_phone }\n  ],\n  office_code: $json.office_code,\n  external_reference_id: $json.opportunity_id\n}) }}",
        "options": {
          "timeout": 15000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 30000
          }
        }
      },

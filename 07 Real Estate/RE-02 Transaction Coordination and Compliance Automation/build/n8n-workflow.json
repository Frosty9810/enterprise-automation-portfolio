    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.id AS deadline_id, d.transaction_id, d.milestone, d.due_date, d.status,\n       t.dotloop_loop_id, t.office_code, t.office_timezone, t.property_address,\n       t.buyer_email, t.buyer_phone, t.seller_email, t.seller_phone,\n       t.agent_email, t.escrow_officer_email, t.escrow_officer_phone\nFROM deadlines d\nJOIN transactions t ON t.id = d.transaction_id\nWHERE d.status = 'pending'\n  AND d.due_date - CURRENT_DATE IN (3, 1, 0);",
        "options": {}
      },
      "id": "a1b2c3d4-0017-4a11-8f01-000000000011",
      "name": "Postgres: Select Deadlines In Window",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        -1400,
        820
      ]
    },
    {
      "parameters": {
        "jsCode": "// Compute the notification tier (T-3 / T-1 / T-0) for each deadline row.\n// Mirrors SOP Section 14 notification_windows().\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nreturn $input.all().map((item) => {\n  const due = new Date(item.json.due_date);\n  due.setHours(0, 0, 0, 0);\n  const deltaDays = Math.round((due.getTime() - today.getTime()) / 86400000);\n\n  let tier = null;\n  if (deltaDays === 3) tier = 'T-3';\n  else if (deltaDays === 1) tier = 'T-1';\n  else if (deltaDays === 0) tier = 'T-0';\n\n  return {\n    json: {\n      ...item.json,\n      delta_days: deltaDays,\n      notification_tier: tier\n    }\n  };\n});"
      },
      "id": "a1b2c3d4-0018-4a11-8f01-000000000012",
      "name": "Code: Compute Notification Tier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1200,
        820
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-tier-t0",
              "leftValue": "={{ $json.notification_tier }}",
              "rightValue": "T-0",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0019-4a11-8f01-000000000013",
      "name": "If: Tier Is T-0",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -1000,
        820
      ]
    },

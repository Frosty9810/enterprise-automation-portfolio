    {
      "id": "canonical-history",
      "title": "Decomposed history spelling of a composed declaration is refused",
      "category": "supported-variant",
      "input": {
        "tenant": "acme",
        "commandId": "variant-05",
        "profile": "echo",
        "entities": [
          {
            "id": "person",
            "value": "José Example"
          }
        ],
        "frames": {
          "query": "Summarize José Example.",
          "context": [
            "Public synthetic context."
          ],
          "history": [
            {
              "role": "assistant",
              "text": "José Example is the fictional contact."
            }
          ],
          "tools": [
            {
              "name": "lookup_delivery",
              "args": {
                "contact": "José Example",
                "items": [
                  {
                    "note": "Public synthetic fixture."
                  }
                ]
              }
            }
          ]
        }
      },
      "expected": {
        "status": "rejected",
        "errorCode": "declared_literal_variant_leak",
        "exposedVariants": []
      },
      "rationale": "NFKC composes the history accent so it compares equal after lowercasing. Guarding does not rewrite or silently alias the alternate spelling."
    },

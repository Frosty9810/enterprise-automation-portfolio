{
  "schemaVersion": 1,
  "suiteId": "veilrag-declared-variant-v1",
  "authorship": {
    "kind": "independent-ai-fixture-author",
    "humanReviewed": false,
    "note": "A separate AI fixture author read the existing public VeilRAG exact-alias contract and the proposed NFKC-plus-lowercase rejection contract, then froze these complete protect DTOs and expected outcomes before running or reading any new variant-guard output. These synthetic acceptance judgments are not human-reviewed truth or a privacy/detector benchmark."
  },
  "scope": "Public synthetic fixtures for bounded declared-literal variant rejection. Exact alias replacement/restoration remains unchanged; unsupported encodings, inserted zero-width characters, cross-script confusables and non-full-casefold equivalences deliberately remain visible. No automatic entity detection, provider transmission, authenticated identity or general privacy guarantee.",
  "cases": [
    {
      "id": "exact-across-all-surfaces",
      "title": "Exact declared text across query, context, history and nested arguments",
      "category": "exact-utility",
      "input": {
        "tenant": "acme",
        "commandId": "variant-01",
        "profile": "echo",
        "entities": [
          {
            "id": "person",
            "value": "Ada Example"
          }
        ],
        "frames": {
          "query": "Summarize Ada Example.",
          "context": [
            "Ada Example has a fictional Friday delivery."
          ],
          "history": [
            {
              "role": "user",
              "text": "Keep Ada Example in this synthetic example."
            }
          ],
          "tools": [
            {
              "name": "lookup_delivery",
              "args": {
                "contact": "Ada Example",
                "items": [
                  {
                    "note": "Ada Example"
                  }
                ]
              }
            }
          ]
        }
      },
      "expected": {
        "status": "protected",
        "errorCode": null,
        "exposedVariants": []
      },
      "rationale": "All occurrences are exact declared literals and must become the same session alias; no variant remains. Explicit restoration should retain the exact original spelling."
    },
    {
      "id": "exact-longest-overlap",
      "title": "Longest exact occurrence and shorter declared literal remain usable",
      "category": "exact-utility",
      "input": {
        "tenant": "acme",
        "commandId": "variant-02",
        "profile": "echo",
        "entities": [
          {
            "id": "person",
            "value": "Ann Example"
          },
          {
            "id": "short-person",
            "value": "Ann"
          }
        ],
        "frames": {
          "query": "Ann Example and Ann are synthetic names.",
          "context": [
            "Public synthetic context."
          ],
          "history": [
            {
              "role": "user",
              "text": "Use only the supplied fixture."
            }
          ],
          "tools": [
            {
              "name": "lookup_delivery",
              "args": {
                "contact": "Ann Example",
                "items": [
                  {
                    "note": "Public synthetic fixture."
                  }
                ]
              }
            }
          ]
        }
      },
      "expected": {
        "status": "protected",
        "errorCode": null,
        "exposedVariants": []
      },
      "rationale": "Exact replacement retains longest-first overlap behavior. These name spellings cannot occur incidentally in the hexadecimal alias ID, keeping this utility case separate from documented conservative short-literal false positives."
    },
    {
      "id": "case-query-mixed",
      "title": "Exact query spelling does not cover a lowercase variant",
      "category": "supported-variant",
      "input": {
        "tenant": "acme",

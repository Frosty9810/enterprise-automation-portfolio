      },
      "id": "a1b2c3d4-0001-4a1a-9c1a-000000000001",
      "name": "Webhook - Usage Event Stream",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1600, 0],
      "webhookId": "atlas-usage-event"
    },
    {
      "parameters": {
        "jsCode": "// Validate HMAC signature and normalize the incoming usage event.\n// Mirrors SOP Section 12 Step 1 / Section 16 / Section 24.\nconst crypto = require('crypto');\n\nconst secret = $env.ATLAS_WEBHOOK_SECRET || '';\nconst body = $input.first().json;\nconst headers = $input.first().json.headers || {};\n\nconst signature = headers['x-atlas-signature'] || '';\nconst payload = JSON.stringify(body.body || body);\nconst expected = crypto.createHmac('sha256', secret).update(payload).digest('hex');\n\nconst validSignature = signature === expected;\nconst evt = (body.body || body);\n\nconst VALID_TYPES = ['feature_activated', 'integration_connected', 'workflow_created', 'seat_invited'];\n\nconst now = new Date();\nconst eventTimestamp = new Date(evt.timestamp);\nconst maxFuture = 24 * 60 * 60 * 1000;\nconst maxPast = 30 * 24 * 60 * 60 * 1000;\n\nconst timestampValid = !isNaN(eventTimestamp.getTime())\n  && (eventTimestamp.getTime() - now.getTime()) < maxFuture\n  && (now.getTime() - eventTimestamp.getTime()) < maxPast;\n\nconst typeValid = VALID_TYPES.includes(evt.event_type);\n\nreturn [{\n  json: {\n    account_id: evt.account_id,\n    user_id: evt.user_id,\n    event_type: evt.event_type,\n    event_id: evt.event_id,\n    timestamp: evt.timestamp,\n    metadata: evt.metadata || {},\n    source: evt.source || 'atlas-product-event-api',\n    valid_signature: validSignature,\n    type_valid: typeValid,\n    timestamp_valid: timestampValid,\n    is_valid: validSignature && typeValid && timestampValid\n  }\n}];"
      },
      "id": "a1b2c3d4-0002-4a1a-9c1a-000000000002",
      "name": "Validate & Normalize Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1380, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "b1c2d3e4-0001",
              "leftValue": "={{ $json.is_valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4a1a-9c1a-000000000003",
      "name": "If - Event Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,

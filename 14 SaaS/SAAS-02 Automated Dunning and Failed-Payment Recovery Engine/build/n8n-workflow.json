    {
      "parameters": {
        "jsCode": "// Extract plan tier, decline reason, and MRR from the Stripe event payload\n// and normalize into the internal dunning-case shape (SOP Section 15).\nconst body = $input.first().json.body ?? $input.first().json;\nconst invoice = body.data.object;\nconst lastError = body.last_payment_error ?? {};\n\nconst planTier = invoice.metadata?.plan_tier ?? 'smb';\nconst accountId = invoice.metadata?.account_id ?? null;\nconst declineReason = lastError.decline_code ?? lastError.code ?? 'unknown';\n\n// MRR lookup would normally hit the billing system; using subscription\n// metadata here as the illustrative source per SOP Section 4/16.\nconst mrrCents = Number(invoice.metadata?.mrr_cents ?? 0);\nconst highValueThresholdCents = 150000; // $1,500/mo, SOP Section 14\nconst highValue = mrrCents >= highValueThresholdCents;\n\nreturn [{\n  json: {\n    dunning_case_id: `dc_${invoice.id}`,\n    invoice_id: invoice.id,\n    stripe_customer_id: invoice.customer,\n    account_id: accountId,\n    plan_tier: planTier,\n    decline_reason: declineReason,\n    amount_due_cents: invoice.amount_due,\n    currency: invoice.currency,\n    mrr_cents: mrrCents,\n    high_value: highValue,\n    card_last4: lastError.payment_method?.card?.last4 ?? null,\n    card_brand: lastError.payment_method?.card?.brand ?? null,\n    failed_at: new Date(body.created * 1000).toISOString(),\n    source_event_id: body.id\n  }\n}];"
      },
      "id": "a1b2c3d4-0002-4bbb-9002-000000000002",
      "name": "Extract Tier and Failure Reason",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

{
  "schemaVersion": 1,
  "suiteId": "atlasgraph-markdown-parser-v1",
  "authorship": {
    "kind": "independent-ai-fixture-author",
    "humanReviewed": false,
    "note": "A separate AI fixture author derived source text, explicit claims/references and functional page/span expectations from the original public AtlasGraph example and the agreed narrow Markdown contract before running or reading new parser output. These are synthetic functional acceptance labels, not model quality judgments or verified business truth."
  },
  "scope": "Public synthetic Markdown parser/annotation acceptance cases. Heading boundaries and raw section spans are independently authored; claims and reference quotes remain explicit inputs. No Markdown renderer, arbitrary code execution, URL/file ingestion, source authentication, semantic extraction or external customs/provider acceptance.",
  "cases": [
    {
      "id": "three-source-two-hop",
      "title": "Three synthetic Markdown sources retain the existing two-hop business evidence",
      "input": {
        "tenant": "harbor-demo",
        "sources": [
          {
            "id": "supplier-record",
            "version": "markdown-v1",
            "title": "Synthetic supplier shipment",
            "approved": true,
            "markdown": "\r\n# Sample shipment terms {#shipment}\r\nSample shipment uses Incoterm DAP. Restricted goods must follow customs-checks before release.\r\nFictional source note: Caf\u00e9 Harbor \ud83d\udce6; preserve this supplied spelling.\r\n```text\r\n# Code-only example {#not-a-page}\r\nThis fenced text is not a compiled heading.\r\n```\r\n",
            "annotations": [
              {
                "pageId": "shipment",
                "claims": [
                  {
                    "key": "incoterm",
                    "value": "DAP"
                  }
                ],
                "references": [
                  {
                    "to": "customs-checks",
                    "relation": "requires",
                    "quote": "Restricted goods must follow customs-checks before release."
                  }
                ]
              }
            ]
          },
          {
            "id": "customs-policy",
            "version": "markdown-v1",
            "title": "Synthetic customs guidance",
            "approved": true,
            "markdown": "## Restricted goods release check {#customs-checks}\nRestricted goods require a signed permit before release. The approval-threshold policy names the required approver.\n",
            "annotations": [
              {
                "pageId": "customs-checks",
                "claims": [
                  {
                    "key": "customsRule",
                    "value": "signed permit before release"
                  }
                ],
                "references": [
                  {
                    "to": "approval-threshold",
                    "relation": "requires",
                    "quote": "The approval-threshold policy names the required approver."
                  }
                ]
              }
            ]
          },
          {
            "id": "approval-policy",
            "version": "markdown-v1",
            "title": "Synthetic internal approval policy",
            "approved": true,
            "markdown": "### Restricted shipment approval {#approval-threshold}\nFor this synthetic shipment, release requires operations director approval after permit verification.\n",
            "annotations": [
              {
                "pageId": "approval-threshold",
                "claims": [
                  {
                    "key": "approval",
                    "value": "operations director approval"
                  }
                ],
                "references": []
              }
            ]
          }
        ]
      },
      "expected": {
        "status": "parsed",
        "pageIdsBySource": {
          "supplier-record": [
            "shipment"
          ],
          "customs-policy": [
            "customs-checks"
          ],
          "approval-policy": [
            "approval-threshold"
          ]
        },
        "sections": [
          {
            "sourceId": "supplier-record",
            "pageId": "shipment",
            "text": "\r\n# Sample shipment terms {#shipment}\r\nSample shipment uses Incoterm DAP. Restricted goods must follow customs-checks before release.\r\nFictional source note: Caf\u00e9 Harbor \ud83d\udce6; preserve this supplied spelling.\r\n```text\r\n# Code-only example {#not-a-page}\r\nThis fenced text is not a compiled heading.\r\n```\r\n",
            "startUtf16": 0,
            "endUtf16": 302,
            "startUtf8": 0,
            "endUtf8": 305
          },
          {
            "sourceId": "customs-policy",
            "pageId": "customs-checks",
            "text": "## Restricted goods release check {#customs-checks}\nRestricted goods require a signed permit before release. The approval-threshold policy names the required approver.\n",
            "startUtf16": 0,
            "endUtf16": 168,
            "startUtf8": 0,
            "endUtf8": 168
          },
          {
            "sourceId": "approval-policy",
            "pageId": "approval-threshold",
            "text": "### Restricted shipment approval {#approval-threshold}\nFor this synthetic shipment, release requires operations director approval after permit verification.\n",
            "startUtf16": 0,
            "endUtf16": 157,
            "startUtf8": 0,
            "endUtf8": 157
          }
        ]
      },
      "rationale": "One page per source, explicit authored claims/references, CRLF and Unicode preserved. A heading inside a closed fence is not a page."
    },
    {
      "id": "two-sections-fenced-fake",
      "title": "Two raw sections retain leading blank lines and ignore fenced headings",
      "input": {
        "tenant": "harbor-demo",
        "sources": [
          {
            "id": "packing-source",
            "version": "v1",
            "title": "Public synthetic source",
            "approved": true,
            "markdown": "\n# Packing record {#packing}\nR\u00e9sum\u00e9 \ud83d\udce6: Packing review points to release.\n```txt\n## Fake heading {#ghost}\n```\n## Release note {#release}\nRelease state: cleared.\n",
            "annotations": [
              {
                "pageId": "packing",
                "claims": [],
                "references": [
                  {
                    "to": "release",
                    "relation": "requires",
                    "quote": "Packing review points to release."
                  }
                ]
              },
              {
                "pageId": "release",
                "claims": [
                  {
                    "key": "state",
                    "value": "cleared"
                  }
                ],
                "references": []
              }
            ]
          }
        ]
      },
      "expected": {
        "status": "parsed",
        "pageIdsBySource": {
          "packing-source": [
            "packing",
            "release"
          ]
        },
        "sections": [
          {
            "sourceId": "packing-source",
            "pageId": "packing",
            "text": "\n# Packing record {#packing}\nR\u00e9sum\u00e9 \ud83d\udce6: Packing review points to release.\n```txt\n## Fake heading {#ghost}\n```\n",
            "startUtf16": 0,
            "endUtf16": 110,
            "startUtf8": 0,
            "endUtf8": 114
          },
          {
            "sourceId": "packing-source",
            "pageId": "release",
            "text": "## Release note {#release}\nRelease state: cleared.\n",
            "startUtf16": 110,
            "endUtf16": 161,
            "startUtf8": 114,
            "endUtf8": 165
          }
        ]
      },
      "rationale": "The first raw section includes leading blank lines and the entire closed fence. The second begins exactly at its explicit column-zero heading. UTF-16 and UTF-8 positions differ around the supplied emoji."
    },

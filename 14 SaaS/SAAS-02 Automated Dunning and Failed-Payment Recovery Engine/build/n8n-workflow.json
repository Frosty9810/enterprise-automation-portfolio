      "parameters": {
        "jsCode": "// Mark the matching dunning case recovered and prepare a QuickBooks\n// journal-entry payload for AR reconciliation (SOP FR-7 / Section 11 Step 11).\nconst body = $input.first().json.body ?? $input.first().json;\nconst invoice = body.data.object;\n\nreturn [{\n  json: {\n    invoice_id: invoice.id,\n    stripe_customer_id: invoice.customer,\n    amount_paid_cents: invoice.amount_paid ?? invoice.amount_due,\n    currency: invoice.currency,\n    recovered_at: new Date(body.created * 1000).toISOString(),\n    source_event_id: body.id\n  }\n}];"
      },
      "id": "a1b2c3d4-0024-4111-9024-000000000024",
